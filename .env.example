# Thanh Long Billiards - Environment Variables Example
# Sao chép file này thành .env hoặc cấu hình trực tiếp trên Vercel: Project Settings -> Environment Variables

# 1. Mật khẩu Quản trị viên (Admin PIN / Password)
VITE_ADMIN_PASSWORD=thanhlong2026

# 2. Cấu hình kết nối đám mây Supabase (Đồng bộ thời gian thực PC & Mobile)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
